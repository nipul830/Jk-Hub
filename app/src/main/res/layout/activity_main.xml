<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="JK HUB"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="20dp" />

        <EditText
            android:id="@+id/webhookUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Webhook URL"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/signalType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Signal Type (BUY / SELL)"
            android:text="BUY" />

        <EditText
            android:id="@+id/pair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Pair"
            android:text="BTCUSDT" />

        <EditText
            android:id="@+id/entry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Entry"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/sl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Stop Loss"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/tp1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Take Profit 1"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/tp2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Take Profit 2"
            android:inputType="numberDecimal" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SEND SIGNAL"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready"
            android:textSize="16sp"
            android:gravity="center"
            android:paddingTop="20dp" />

    </LinearLayout>

</ScrollView>
